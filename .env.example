# Point the frontend at the real backend (cales-backend).
# When unset, the app serves the in-repo mock dataset (src/data/mock.ts).
# Copy to .env.local and set the URL once Josep & Guillem's API is up.
#
# VITE_API_URL=http://localhost:8000
# VITE_AGENT_API_URL=http://localhost:8000
# Optional: may be either the backend base URL or the full /agent/ui endpoint.
# VITE_UI_AGENT_API_URL=http://localhost:8000
